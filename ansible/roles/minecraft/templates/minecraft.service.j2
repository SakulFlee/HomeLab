[Unit]
Description=Minecraft Paper Server (Screen Session)
After=network.target

[Service]
User={{ minecraft_user }}
Group={{ minecraft_group }}
WorkingDirectory={{ minecraft_home }}
Type=forking

# Start Minecraft inside a detached screen session
ExecStart=/usr/bin/screen -dmS minecraft /usr/bin/java -Xms{{ minecraft_init_memory }} -Xmx{{ minecraft_max_memory }} -jar server.jar nogui

# Safely shut down the server by sending "stop" to the screen console
ExecStop=/usr/bin/screen -S minecraft -X stuff "stop\n"

# Automatically restart if the server crashes
Restart=always

[Install]
WantedBy=multi-user.target
