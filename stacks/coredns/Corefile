.:53 {
    # Split horizon for administrative names. Public names fall through to the
    # upstream resolvers.
    template IN A {
        match "^(opencode|syncthing|vpn|wireguard-ui|dockge)\.sakul-flee\.de\.$"
        answer "{{ .Name }} 60 IN A 192.168.178.200"
        fallthrough
    }

    template IN AAAA {
        match "^(opencode|syncthing|vpn|wireguard-ui|dockge)\.sakul-flee\.de\.$"
        rcode NOERROR
        fallthrough
    }

    template IN HTTPS {
        match "^(opencode|syncthing|vpn|wireguard-ui|dockge)\.sakul-flee\.de\.$"
        rcode NOERROR
        fallthrough
    }

    forward . 9.9.9.9 149.112.112.112
    cache
    errors
    reload
}
