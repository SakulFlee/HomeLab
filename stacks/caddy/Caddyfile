{
	email dev@sakul-flee.de
	acme_dns cloudflare {env.CF_API_TOKEN}
	# Override with ACME_CA in /etc/homelab/host.env to use the Let's Encrypt
	# staging directory while validating DNS and routing.
	acme_ca {$ACME_CA}
}

# Admin services are reachable from the LAN and the WireGuard tunnel only.
# The source address is the real client because admin DNS names are not
# Cloudflare-proxied.
(vpn_only) {
	@notvpn not remote_ip 100.64.0.0/10 192.168.178.0/24
	respond @notvpn "This service is reachable over the LAN or VPN only.\n" 403
}

# ---------------------------------------------------------------------------
# Public services
# ---------------------------------------------------------------------------

forgejo.sakul-flee.de, code.sakul-flee.de, ci.sakul-flee.de, git.sakul-flee.de, issues.sakul-flee.de, pr.sakul-flee.de {
	reverse_proxy forgejo:3000 {
		header_up Host {http.request.host}
	}
}

fluxer.sakul-flee.de {
	reverse_proxy fluxer-edge:8080 {
		header_up Host {http.request.host}
	}
}

sakul-flee.de, www.sakul-flee.de {
	reverse_proxy website:80 {
		header_up Host {http.request.host}
	}
}

# ---------------------------------------------------------------------------
# Admin services (LAN/VPN only)
# ---------------------------------------------------------------------------

opencode.sakul-flee.de {
	import vpn_only

	reverse_proxy opencode:4096 {
		header_up Host {http.request.host}
		flush_interval -1
	}
}

chamber.sakul-flee.de {
	import vpn_only

	# OpenChamber is a second UI on the same OpenCode server. Streams state
	# and terminal output over long-lived connections.
	reverse_proxy openchamber:3000 {
		header_up Host {http.request.host}
		flush_interval -1
	}
}

hermes.sakul-flee.de {
	import vpn_only

	# Hermes' browser workspace (chat and PTY) runs on 9120 and keeps
	# WebSockets open, so response buffering must stay off.
	reverse_proxy hermes:9120 {
		header_up Host {http.request.host}
		flush_interval -1
	}
}

syncthing.sakul-flee.de {
	import vpn_only

	reverse_proxy syncthing:8384 {
		header_up Host {http.request.host}
	}
}

vpn.sakul-flee.de, wireguard-ui.sakul-flee.de {
	import vpn_only

	# wg-easy runs with host networking, so reach the host address rather
	# than a container name.
	reverse_proxy http://{$HOMELAB_LAN_IP}:51821 {
		header_up Host {http.request.host}
	}
}

dockge.sakul-flee.de {
	import vpn_only

	reverse_proxy dockge:5001 {
		header_up Host {http.request.host}
	}
}

home.sakul-flee.de {
	import vpn_only

	# Home Assistant uses host networking, so reach the host address rather
	# than a container name. The frontend keeps a websocket open for live
	# state; -1 disables response buffering so updates are not batched.
	reverse_proxy http://{$HOMELAB_LAN_IP}:8123 {
		header_up Host {http.request.host}
		flush_interval -1
	}
}

paperless.sakul-flee.de {
	import vpn_only

	# Plain http:// upstream: Caddy terminates TLS and Paperless speaks HTTP on
	# 8000 inside the stack. header_up Host is required, not cosmetic: Paperless
	# derives ALLOWED_HOSTS and its redirect target from PAPERLESS_URL and the
	# Host header, so it must see the name the browser asked for.
	reverse_proxy paperless:8000 {
		header_up Host {http.request.host}
	}
}

# Self-hosted notification relay. Public on purpose: it must be reachable from
# phones outside the LAN/VPN. ntfy enforces its own authentication.
ntfy.sakul-flee.de {
	reverse_proxy ntfy:80
}

# Catch-all for unknown names. The proxied wildcard sends every subdomain to
# this origin, so without a matching site Caddy aborts the TLS handshake and
# Cloudflare reports 525. A wildcard certificate plus a plain 404 makes a typo
# obvious instead of looking like an outage. Explicit sites above win.
*.sakul-flee.de {
	respond "No such site." 404
}

# Frequent typo for the notification relay.
nfty.sakul-flee.de {
	redir https://ntfy.sakul-flee.de{uri} permanent
}
