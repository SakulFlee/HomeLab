{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "opencode-go": {
      "settings": {
        "apiKey": "{env:OPENCODE_API_KEY}"
      }
    },
    "ollama": {
      "name": "Ollama (local)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen 3.5 9B (local)",
          "modelID": "qwen3.5:9b",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
