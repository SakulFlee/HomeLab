# Installed to /srv/docker/hermes/home/.gitconfig by prepare-data.sh. Hermes'
# tool subprocesses use /opt/data/home as HOME, so this is the git identity and
# credential helper they see. The token is never written here: the helper reads
# FORGEJO_TOKEN from the container environment.
[user]
	name = SakulFlee
	email = sakulflee@noreply.forgejo.sakul-flee.de
[credential]
	helper = "!f() { echo username=SakulFlee; echo \"password=$FORGEJO_TOKEN\"; }; f"
[safe]
	directory = *
[url "http://forgejo:3000/"]
	insteadOf = https://forgejo.sakul-flee.de/
