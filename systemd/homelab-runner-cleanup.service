[Unit]
Description=HomeLab Forgejo runner cache and workspace cleanup
After=network-online.target docker.service
Requires=docker.service
OnFailure=homelab-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/homelab
EnvironmentFile=-/etc/homelab/notify.env
ExecStart=/opt/homelab/scripts/forgejo-runner-cleanup.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
