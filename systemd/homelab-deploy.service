[Unit]
Description=HomeLab deploy from Git
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
OnFailure=homelab-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/homelab
EnvironmentFile=-/etc/homelab/notify.env
ExecStart=/opt/homelab/scripts/deploy.sh
TimeoutStartSec=45min
Nice=10
