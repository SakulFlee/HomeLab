#!/usr/bin/env python3
"""
PIA WireGuard connection script
Managed by Ansible - DO NOT EDIT MANUALLY
"""

import base64
import json
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

PIA_USER = "{{ vault_vpn_pia_username }}"
PIA_PASS = "{{ vault_vpn_pia_password }}"
PIA_REGION = "{{ pia_region }}"
WG_INTERFACE = "{{ pia_wg_interface }}"
WG_CONFIG = "{{ pia_config_dir }}/{{ pia_wg_interface }}.conf"

def log(msg):
    print(f"[pia-wg] {msg}", flush=True)

def url_get(url, auth=None, data=None):
    req = urllib.request.Request(url, data=data)
    if auth:
        credentials = f"{auth[0]}:{auth[1]}"
        b64 = base64.b64encode(credentials.encode()).decode()
        req.add_header("Authorization", f"Basic {b64}")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        log(f"HTTP Error {e.code}: {e.reason}")
        return None
    except urllib.error.URLError as e:
        log(f"URL Error: {e.reason}")
        return None
    except Exception as e:
        log(f"Error: {e}")
        return None

def get_token():
    log("Authenticating with PIA...")
    data = url_get("https://www.privateinternetaccess.com/gtoken/generateToken",
                   auth=(PIA_USER, PIA_PASS))
    if data and data.get("status") == "OK":
        log("Authentication successful.")
        return data["token"]
    log(f"ERROR: Authentication failed. Response: {data}")
    return None

def get_servers():
    log("Fetching server list...")
    raw = None
    try:
        with urllib.request.urlopen(
            "https://serverlist.piaservers.net/vpninfo/servers/v6",
            timeout=30
        ) as resp:
            raw = resp.read().decode()
            raw = raw.split(chr(10))[0]
    except Exception as e:
        log(f"ERROR: Failed to fetch server list: {e}")
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        log(f"ERROR: Failed to parse server list: {e}")
        return None

def find_server(servers, region):
    region_lower = region.lower()
    for group in servers.get("groups", []):
        if group.get("name", "").lower() == region_lower:
            for server in group.get("servers", []):
                cn = server.get("cn", "")
                ip = server.get("ip", "")
                if cn and ip:
                    return ip, cn
            break
    log(f"ERROR: No server found for region '{region}'")
    log(f"Available regions: {[g['name'] for g in servers.get('groups', []) if g.get('name')]}")
    return None, None

def generate_wireguard_keys():
    log("Generating WireGuard keys...")
    try:
        priv = subprocess.run(["wg", "genkey"], capture_output=True,
                              text=True, check=True).stdout.strip()
        pub = subprocess.run(["wg", "pubkey"], input=priv,
                             capture_output=True, text=True,
                             check=True).stdout.strip()
        return priv, pub
    except subprocess.CalledProcessError as e:
        log(f"ERROR: Failed to generate WireGuard keys: {e}")
        return None, None
    except FileNotFoundError:
        log("ERROR: 'wg' command not found. Install wireguard-tools.")
        return None, None

def register_key(token, server_ip, pubkey):
    log(f"Registering public key with PIA server {server_ip}...")
    url = f"https://{server_ip}:1337/addKey?pt={token}"
    data = urllib.parse.urlencode({"pubkey": pubkey}).encode()
    result = url_get(url, data=data)
    if result and result.get("status") == "OK":
        log("Key registration successful.")
        return result
    log(f"ERROR: Key registration failed. Response: {result}")
    return None

def write_wg_config(privkey, peer_ip, server_pubkey, server_ip, server_port):
    config_lines = [
        "[Interface]",
        f"PrivateKey = {privkey}",
        f"Address = {peer_ip}",
        "DNS = 10.0.0.243",
        "",
        "[Peer]",
        f"PublicKey = {server_pubkey}",
        f"Endpoint = {server_ip}:{server_port}",
        "AllowedIPs = 0.0.0.0/0",
        "PersistentKeepAlive = 25",
        "",
    ]
    config = chr(10).join(config_lines)
    path = Path(WG_CONFIG)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(config)
    path.chmod(0o600)
    log(f"WireGuard config written to {WG_CONFIG}")

def wg_quick_up():
    log(f"Bringing up WireGuard interface {WG_INTERFACE}...")
    result = subprocess.run(["wg-quick", "up", WG_INTERFACE],
                            capture_output=True, text=True)
    if result.returncode == 0:
        log("WireGuard connected successfully.")
        return True
    log(f"ERROR: Failed to bring up WireGuard: {result.stderr}")
    return False

def wg_quick_down():
    log(f"Bringing down WireGuard interface {WG_INTERFACE}...")
    subprocess.run(["wg-quick", "down", WG_INTERFACE],
                   capture_output=True, text=True)
    log("WireGuard disconnected.")

def is_connected():
    result = subprocess.run(["ip", "link", "show", WG_INTERFACE],
                            capture_output=True, text=True)
    return result.returncode == 0

def connect():
    if Path(WG_CONFIG).exists() and is_connected():
        log("WireGuard already connected.")
        return True

    token = get_token()
    if not token:
        return False

    servers = get_servers()
    if not servers:
        return False

    server_ip, server_cn = find_server(servers, PIA_REGION)
    if not server_ip:
        return False
    log(f"Selected server: {server_cn} ({server_ip})")

    privkey, pubkey = generate_wireguard_keys()
    if not privkey:
        return False

    result = register_key(token, server_ip, pubkey)
    if not result:
        return False

    write_wg_config(privkey, result["peer_ip"],
                    result["server_key"], server_ip, result["server_port"])

    if not wg_quick_up():
        return False

    return True

def disconnect():
    wg_quick_down()


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "connect"
    if action == "connect":
        sys.exit(0 if connect() else 1)
    elif action == "disconnect":
        disconnect()
        sys.exit(0)
    else:
        print(f"Usage: {sys.argv[0]} {connect|disconnect}")
        sys.exit(1)
