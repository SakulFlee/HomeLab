#!/usr/bin/env python3
"""
PIA Port Forwarding Monitor
Monitors piactl for VPN connection state and forwarded port changes.
Injects the forwarded port into qBittorrent config and restarts it.
Managed by Ansible - DO NOT EDIT MANUALLY
"""

import os
import subprocess
import sys
import time
from pathlib import Path

QB_CONFIG = "{{ qbittorrent_config_dir }}/qBittorrent.conf"
CHECK_INTERVAL = {{ qbittorrent_port_monitor_interval }}
DEFAULT_PORT = 6881


def log(msg):
    print(f"[pia-port-monitor] {msg}", flush=True)


def get_vpn_state():
    """Get current PIA VPN connection state."""
    try:
        result = subprocess.run(
            ["piactl", "get", "connectionstate"],
            capture_output=True, text=True, timeout=10
        )
        return result.stdout.strip() if result.returncode == 0 else None
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None


def get_forwarded_port():
    """Get the current forwarded port from piactl. Returns int or None."""
    try:
        result = subprocess.run(
            ["piactl", "get", "portforward"],
            capture_output=True, text=True, timeout=10
        )
        out = result.stdout.strip()
        if out.isdigit():
            return int(out)
        return None
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None


def get_listening_port():
    """Get the current listening port from qBittorrent config."""
    try:
        content = Path(QB_CONFIG).read_text()
        for line in content.split(chr(10)):
            if line.startswith("Session\\Port="):
                return int(line.split("=", 1)[1])
    except (FileNotFoundError, ValueError):
        pass
    return None


def set_listening_port(port):
    """Update the listening port in qBittorrent config."""
    try:
        path = Path(QB_CONFIG)
        content = path.read_text()
        lines = content.split(chr(10))
        new_lines = []
        for line in lines:
            if line.startswith("Session\\Port="):
                new_lines.append(f"Session\\Port={port}")
            else:
                new_lines.append(line)
        path.write_text(chr(10).join(new_lines))
        log(f"qBittorrent port set to {port} in config")
        return True
    except Exception as e:
        log(f"ERROR: Failed to update config: {e}")
        return False


def restart_qbittorrent():
    """Restart qBittorrent service."""
    log("Restarting qBittorrent...")
    try:
        subprocess.run(
            ["systemctl", "restart", "qbittorrent"],
            capture_output=True, text=True, check=True, timeout=30
        )
        log("qBittorrent restarted.")
        return True
    except subprocess.CalledProcessError as e:
        log(f"ERROR: Failed to restart qBittorrent: {e.stderr}")
        return False


def main():
    log(f"Starting PIA port monitor (check interval: {CHECK_INTERVAL}s)")
    last_state = None
    last_port = get_listening_port() or DEFAULT_PORT

    while True:
        try:
            state = get_vpn_state()
            if state != last_state:
                log(f"VPN state: {state}")
                last_state = state

            if state == "Connected":
                pf_port = get_forwarded_port()
                if pf_port is None:
                    log("Waiting for forwarded port...")
                elif pf_port != last_port:
                    log(f"Port changed: {last_port} -> {pf_port}")
                    if set_listening_port(pf_port):
                        restart_qbittorrent()
                        last_port = pf_port
                else:
                    log(f"Port unchanged: {pf_port}")
            else:
                # VPN not connected — keep qBittorrent on default port,
                # but PIA's kill-switch will block its traffic anyway
                if last_port != DEFAULT_PORT and get_listening_port() != DEFAULT_PORT:
                    log(f"VPN down, resetting port to default {DEFAULT_PORT}")
                    set_listening_port(DEFAULT_PORT)
                    restart_qbittorrent()
                    last_port = DEFAULT_PORT

        except Exception as e:
            log(f"ERROR: {e}")

        time.sleep(CHECK_INTERVAL)


if __name__ == "__main__":
    main()
