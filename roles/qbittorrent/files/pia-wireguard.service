[Unit]
Description=PIA WireGuard VPN for qBittorrent
Documentation=https://www.privateinternetaccess.com/
After=network.target nftables.service
Wants=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pia-wg.py connect
ExecStop=/usr/local/bin/pia-wg.py disconnect

[Install]
WantedBy=multi-user.target
