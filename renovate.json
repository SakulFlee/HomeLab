{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "OpenChamber runs the OpenCode CLI for capability checks, and the image must match the server in stacks/opencode",
      "matchPackageNames": [
        "@opencode/cli",
        "/anomalyco\\/opencode$/"
      ],
      "groupName": "opencode"
    }
  ]
}
